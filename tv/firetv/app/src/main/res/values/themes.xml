<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full screen, no action bar, the TV app's dark background from the first frame (no white flash). -->
    <style name="Theme.WeAreRadio.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/tv_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/tv_bg</item>
        <item name="android:navigationBarColor">@color/tv_bg</item>
    </style>
</resources>
